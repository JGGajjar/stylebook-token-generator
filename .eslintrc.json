{
    "env": {
        "browser": true,
        "node": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "airbnb-base"
    ],
    "parserOptions": {
        "ecmaVersion": 12,
        "sourceType": "module"
    },
    "parser": "babel-eslint",
    "rules": {
        "linebreak-style": 0,
        "no-console": "off",
        "quotes": [2, "double", { "avoidEscape": true, "allowTemplateLiterals": true}],
        "max-len": ["error", { "code": 250 }],
        "no-underscore-dangle" : 0,
        "no-unused-vars" : 0,
        "eqeqeq" : 0, 
        "consistent-return" :0, 
        "implicit-arrow-linebreak" : 0, 
        "no-return-await" : 0,
        "no-shadow" : 0,
        "wrap-iife" : 0,
        "no-plusplus" : 0,
        "func-names" : 0,
        "operator-linebreak" : 0,
        "no-param-reassign" : 0,
        "array-callback-return" : 0,
        "no-unused-expressions" : 0,
        "indent" : 0,
        "comma-dangle" : 0
    }
}
